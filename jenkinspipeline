pipeline {
    agent any
    environment{
        registry="154693041487.dkr.ecr.us-east-1.amazonaws.com/my-docker-repo"
    }
    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/vinay775/docker-spring-boot.git'
            }
        }
        stage('Build Jar') {
            steps {
                sh 'mvn clean install'
            }
        }
        stage("Docker Image"){
            steps{
                script{
                    dockerImage = docker.build registry 
                    dockerImage.tag("$BUILD_NUMBER")
                }
            }
        }
        stage("push image to ecr"){
            steps{
                script{
                    sh"aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin 154693041487.dkr.ecr.us-east-1.amazonaws.com"
                    sh"docker push 154693041487.dkr.ecr.us-east-1.amazonaws.com/my-docker-repo:$BUILD_NUMBER"
                }
            }
        }
        stage("Helm Deploy"){
            steps{
                script{
                    sh"helm upgrade first --install mychart --namespace helm-deployment --set image.tag=$BUILD_NUMBER"
                }
            }
        }

    }
}